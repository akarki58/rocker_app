<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-01-25 -->
<odoo>
    <record id="rocker_executor_view_form" model="ir.ui.view">
        <field name="name">rocker.executor.view.form</field>
        <field name="model">ir.cron</field>
        <field name="arch" type="xml">
            <form string="Rocker Report Executor" save="true" create="false" delete="false" discard="false" edit="true">
                <header>
                    <button name="method_direct_trigger" type="object" string="Run Manually" class="oe_highlight"/>
                    <button name="action_unarchive" type="object" class="oe_stat_button" string="Start"/>
                    <button name="action_archive" type="object" class="oe_stat_button" string="Stop"/>
                    <widget name="web_ribbon" class="o_ribbon_front" title="Stopped" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" class="o_ribbon_front" title="Running" bg_color="text-bg-success"
                            invisible="not active"/>
                </header>

                <field name="active" eval="True" invisible="1"/>

                <group col="2">
                    <field name="priority"/>
                    <field name="name"/>
                    <field name="nextcall" string="Next Execution"/>
                    <field name="interval_number"/>
                    <field name="interval_type"/>
                    <field name="user_id" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="rocker_executor_view_list" model="ir.ui.view">
        <field name="model">ir.cron</field>
        <field name="arch" type="xml">
            <list string="Scheduled Actions" decoration-muted="(not active)">
                <field name="priority"/>
                <field name="name"/>
                <field name="nextcall"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="user_id" invisible="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="rocker_executor_view_search" model="ir.ui.view">
        <field name="model">ir.cron</field>
        <field name="arch" type="xml">
            <search string="Scheduled Actions">
                <field name="name" string="Scheduled Action"/>
                <field name="user_id"/>
                <field name="nextcall"/>
                <field name="active"/>
                <separator/>
                <filter string="All" name="all" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <group>
                    <filter string="User" name="group_by_user" domain="[]" context="{'group_by':'user_id'}"/>
                    <filter string="Execution" name="group_by_execution" domain="[]" context="{'group_by':'nextcall'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
